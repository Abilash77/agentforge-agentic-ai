# ============================================================
# AgentForge – Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# ── LLM Provider ────────────────────────────────────────────
# Options: openai | anthropic | ollama | gemini | azure
LLM_API_TYPE=openai
LLM_MODEL=gpt-4o
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-openai-api-key-here
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# Anthropic (if using Claude)
# LLM_API_TYPE=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022
# LLM_API_KEY=sk-ant-your-anthropic-key-here

# Ollama (local, no API key needed)
# LLM_API_TYPE=ollama
# LLM_MODEL=llama3.1
# LLM_BASE_URL=http://localhost:11434

# ── Database ─────────────────────────────────────────────────
DB_SQLITE_URL=sqlite+aiosqlite:///agentforge/data/db/agentforge.db
DB_ECHO=false

# ── ChromaDB Vector Store ────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=agentforge/data/chroma
CHROMA_TOP_K=5

# ── Authentication ───────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=your-super-secret-jwt-key-minimum-32-characters-here
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_ENABLE_AUTH=false

# Fernet encryption key for API keys in DB
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_ENCRYPTION_KEY=

# ── Application ──────────────────────────────────────────────
APP_NAME=AgentForge
ENVIRONMENT=development
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8001
FRONTEND_PORT=8501

# ── Budget Limits ─────────────────────────────────────────────
DEFAULT_BUDGET_USD=5.0
MAX_BUDGET_USD=50.0

# ── Features ─────────────────────────────────────────────────
ENABLE_RAG_CONTEXT=true
ENABLE_PERSISTENT_MEMORY=true
ENABLE_COST_TRACKING=true

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_TO_FILE=true
